PORT=4000
# Postgres server URL without a database name. Azure: Azure Database for PostgreSQL flexible server.
PG_SERVER_URL=postgres://postgres:postgres@localhost:5432
PG_SSL=false
CONTROL_DB=whatbox_control
# Local dev only. Each site's key is derived from this. Production uses SITE_KEYS_JSON from Key Vault.
DEV_MASTER_KEY=change-me-local-only
# SITE_KEYS_JSON={"site_afterh":"<64 hex>","site_hfriends":"<64 hex>","site_datealittle":"<64 hex>"}
# Return verification codes in API responses (dev only, never in production)
EXPOSE_DEV_CODES=true
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
