{
  "expo": {
    "name": "AfterH",
    "slug": "whatbox-member",
    "scheme": "whatbox",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whatbox.afterh",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.whatbox.afterh",
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#22655F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used once to find your town, so we can show members near you. Your exact location is never stored or shared."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
