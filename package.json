{
  "name": "whatbox-platform",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev -w @whatbox/api",
    "dev:web": "npm run dev -w @whatbox/web",
    "dev:member": "npm run start -w @whatbox/member",
    "db:migrate": "npm run migrate -w @whatbox/api",
    "db:seed": "npm run seed -w @whatbox/api",
    "test": "npm test -w @whatbox/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:preview": "npm run export:preview -w @whatbox/member"
  }
}
